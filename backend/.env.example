# ─── Server ──────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=3001

# ─── PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hvac_db
DB_USER=hvac_user
DB_PASSWORD=hvacpassword

# ─── JWT ─────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# ─── Internal service secret (ai-service → this backend) ─────────────
# Must match INTERNAL_API_SECRET in ai-service/.env
INTERNAL_API_SECRET=replace_with_shared_internal_secret

# ─── CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
