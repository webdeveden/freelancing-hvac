# ─── Server ──────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ─── PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hvac_db
DB_USER=hvac_user
DB_PASSWORD=hvacpassword

# ─── Anthropic Claude ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# claude-haiku-4-5-20251001 is fast and cost-effective for voice calls
AI_MODEL=claude-haiku-4-5-20251001

# ─── Twilio ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── Backend bridge (internal Docker network or localhost) ────────────
BACKEND_URL=http://localhost:3001
# Must match INTERNAL_API_SECRET in backend/.env
INTERNAL_API_SECRET=replace_with_shared_internal_secret

# ─── Business info (injected into AI system prompt) ───────────────────
BUSINESS_NAME=ABC HVAC Services
BUSINESS_PHONE=+15550010000
SERVICE_AREA=Dallas, TX and surrounding areas
BUSINESS_HOURS=Monday to Friday 8 AM to 6 PM, Saturday 9 AM to 2 PM
EMERGENCY_HOURS=24/7 emergency service available
